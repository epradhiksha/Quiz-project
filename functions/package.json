{
    "name": "heisenbyte-quiz-functions",
    "description": "Firebase Cloud Functions for Heisenbyte Real-Time Quiz backend",
    "version": "1.0.0",
    "engines": {
        "node": "18"
    },
    "main": "index.js",
    "scripts": {
        "lint": "eslint .",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "mocha --exit --timeout 10000 test/index.test.js"
    },
    "dependencies": {
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^5.0.0"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "eslint-config-google": "^0.14.0",
        "firebase-functions-test": "^3.1.0",
        "mocha": "^10.4.0",
        "sinon": "^17.0.1",
        "chai": "^4.4.1"
    },
    "private": true
}