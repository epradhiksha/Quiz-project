rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── QUIZ STATE ───────────────────────────────────────────
    // Admin can read/write. Users can only read.
    match /quiz/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "jecaids@gmail.com";
    }

    // ─── QUESTIONS ────────────────────────────────────────────
    // Admin can write. Authenticated users can read.
    match /questions/{questionId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "jecaids@gmail.com";
    }

    // ─── TEAMS / PARTICIPANTS ─────────────────────────────────
    // Any authenticated user can create their own team.
    // Admin can update scores. Users can read all teams (leaderboard).
    match /teams/{teamId} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // User cannot change their own score
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["score"])
        // Admin can change anything
        || request.auth.token.email == "jecaids@gmail.com"
      );
      allow delete: if request.auth != null && request.auth.token.email == "jecaids@gmail.com";
    }

    // ─── RESPONSES ────────────────────────────────────────────
    // Users can create one response per question.
    // Users cannot update or delete responses.
    // Admin can read all responses.
    match /responses/{responseId} {
      allow create: if request.auth != null
                    && request.resource.data.teamId == request.auth.uid;
      allow read:   if request.auth != null && request.auth.token.email == "jecaids@gmail.com";
      allow update, delete: if false;
    }

  }
}
